#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

typedef struct Node {
    int val;
    struct Node* prev;
    struct Node* next;
} Node;

typedef struct {
    Node* head;
    Node* tail;
    int size;
} Deque;

typedef struct {
    Deque* left;
    Deque* right;
} FrontMiddleBackQueue;

Node* createNode(int val) {
    Node* node = (Node*)malloc(sizeof(Node));
    node->val = val;
    node->prev = NULL;
    node->next = NULL;
    return node;
}

Deque* createDeque() {
    Deque* dq = (Deque*)malloc(sizeof(Deque));
    dq->head = NULL;
    dq->tail = NULL;
    dq->size = 0;
    return dq;
}

void pushDqFront(Deque* dq, int val) {
    Node* node = createNode(val);
    if (dq->size == 0) {
        dq->head = node;
        dq->tail = node;
    } else {
        node->next = dq->head;
        dq->head->prev = node;
        dq->head = node;
    }
    dq->size++;
}

void pushDqBack(Deque* dq, int val) {
    Node* node = createNode(val);
    if (dq->size == 0) {
        dq->head = node;
        dq->tail = node;
    } else {
        node->prev = dq->tail;
        dq->tail->next = node;
        dq->tail = node;
    }
    dq->size++;
}

int popDqFront(Deque* dq) {
    if (dq->size == 0) return -1;
    Node* node = dq->head;
    int val = node->val;
    dq->head = dq->head->next;
    if (dq->head) {
        dq->head->prev = NULL;
    } else {
        dq->tail = NULL;
    }
    free(node);
    dq->size--;
    return val;
}

int popDqBack(Deque* dq) {
    if (dq->size == 0) return -1;
    Node* node = dq->tail;
    int val = node->val;
    dq->tail = dq->tail->prev;
    if (dq->tail) {
        dq->tail->next = NULL;
    } else {
        dq->head = NULL;
    }
    free(node);
    dq->size--;
    return val;
}

void balance(FrontMiddleBackQueue* obj) {
    if (obj->left->size > obj->right->size) {
        int val = popDqBack(obj->left);
        pushDqFront(obj->right, val);
    } else if (obj->right->size > obj->left->size + 1) {
        int val = popDqFront(obj->right);
        pushDqBack(obj->left, val);
    }
}

FrontMiddleBackQueue* frontMiddleBackQueueCreate() {
    FrontMiddleBackQueue* obj = (FrontMiddleBackQueue*)malloc(sizeof(FrontMiddleBackQueue));
    obj->left = createDeque();
    obj->right = createDeque();
    return obj;
}

void frontMiddleBackQueuePushFront(FrontMiddleBackQueue* obj, int val) {
    pushDqFront(obj->left, val);
    balance(obj);
}

void frontMiddleBackQueuePushMiddle(FrontMiddleBackQueue* obj, int val) {
    if (obj->left->size == obj->right->size) {
        pushDqFront(obj->right, val);
    } else {
        pushDqBack(obj->left, val);
    }
    balance(obj);
}

void frontMiddleBackQueuePushBack(FrontMiddleBackQueue* obj, int val) {
    pushDqBack(obj->right, val);
    balance(obj);
}

int frontMiddleBackQueuePopFront(FrontMiddleBackQueue* obj) {
    if (obj->left->size == 0 && obj->right->size == 0) return -1;
    int val;
    if (obj->left->size > 0) {
        val = popDqFront(obj->left);
    } else {
        val = popDqFront(obj->right);
    }
    balance(obj);
    return val;
}

int frontMiddleBackQueuePopMiddle(FrontMiddleBackQueue* obj) {
    if (obj->left->size == 0 && obj->right->size == 0) return -1;
    int val;
    if (obj->left->size == obj->right->size) {
        val = popDqBack(obj->left);
    } else {
        val = popDqFront(obj->right);
    }
    balance(obj);
    return val;
}

int frontMiddleBackQueuePopBack(FrontMiddleBackQueue* obj) {
    if (obj->left->size == 0 && obj->right->size == 0) return -1;
    int val = popDqBack(obj->right);
    balance(obj);
    return val;
}

void freeDeque(Deque* dq) {
    Node* curr = dq->head;
    while (curr) {
        Node* next = curr->next;
        free(curr);
        curr = next;
    }
    free(dq);
}

void frontMiddleBackQueueFree(FrontMiddleBackQueue* obj) {
    freeDeque(obj->left);
    freeDeque(obj->right);
    free(obj);
}
