int* exclusiveTime(int n, char** logs, int logsSize, int* returnSize) {
    int* exclusive_times = (int*)calloc(n, sizeof(int));
    *returnSize = n;
    
    int* stack = (int*)malloc(logsSize * sizeof(int));
    int top = -1;
    int prev_time = 0;
    
    for (int i = 0; i < logsSize; i++) {
        int fn_id;
        char type[6];
        int timestamp;
        
        sscanf(logs[i], "%d:%[^:]:%d", &fn_id, type, &timestamp);
        
        if (type[0] == 's') { 
            if (top != -1) {
                exclusive_times[stack[top]] += timestamp - prev_time;
            }
            stack[++top] = fn_id;
            prev_time = timestamp;
        } else { 
            exclusive_times[stack[top]] += timestamp - prev_time + 1;
            top--;
            prev_time = timestamp + 1;
        }
    }
    
    free(stack);
    return exclusive_times;
}
