#include <stdio.h>
#include <stdlib.h>

int solve_query(int n, int* arr, int k) {
    int* deque = (int*)malloc(n * sizeof(int));
    int head = 0;
    int tail = 0;
    int min_of_maxima = 2000000000; 

    for (int i = 0; i < n; i++) {
        if (head < tail && deque[head] <= i - k) {
            head++;
        }

        while (head < tail && arr[deque[tail - 1]] <= arr[i]) {
            tail--;
        }

        deque[tail++] = i;

        if (i >= k - 1) {
            int current_max = arr[deque[head]];
            if (current_max < min_of_maxima) {
                min_of_maxima = current_max;
            }
        }
    }

    free(deque);
    return min_of_maxima;
}

int main() {
    int n, q;
    if (scanf("%d %d", &n, &q) != 2) return 0;

    int* arr = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    for (int i = 0; i < q; i++) {
        int k;
        scanf("%d", &k);
        int result = solve_query(n, arr, k);
        printf("%d\n", result);
    }

    free(arr);
    return 0;
}
