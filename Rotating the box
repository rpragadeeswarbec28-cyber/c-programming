#include <stdlib.h>

char** rotateTheBox(char** boxGrid, int boxGridSize, int* boxGridColSize, int* returnSize, int** returnColumnSizes) {
    int m = boxGridSize;
    int n = boxGridColSize[0]; 

    for (int i = 0; i < m; i++) {
        int empty_spot = n - 1; // Track the rightmost available cell for a stone
        for (int j = n - 1; j >= 0; j--) {
            if (boxGrid[i][j] == '*') {
                // Obstacle blocks stones; next stone can only land to its left
                empty_spot = j - 1;
            } else if (boxGrid[i][j] == '#') {
                // Move stone to the rightmost empty cell found so far
                boxGrid[i][j] = '.';
                boxGrid[i][empty_spot] = '#';
                empty_spot--;
            }
        }
    }

    *returnSize = n;
    *returnColumnSizes = (int*)malloc(n * sizeof(int));
    char** result = (char**)malloc(n * sizeof(char*));

    for (int i = 0; i < n; i++) {
        (*returnColumnSizes)[i] = m;
        result[i] = (char*)malloc(m * sizeof(char));
    }
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            result[j][m - 1 - i] = boxGrid[i][j];
        }
    }

    return result;
}
