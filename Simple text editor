#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_LEN 1000005

typedef struct {
    int type;      
    int count;     
    char* deleted; 
} Operation;

int main() {
    int q;
    if (scanf("%d", &q) != 1) return 0;

    char* S = (char*)malloc(MAX_LEN * sizeof(char));
    int s_len = 0;
    S[0] = '\0';

    Operation* undo_stack = (Operation*)malloc(q * sizeof(Operation));
    int top = -1;

    char* arg_str = (char*)malloc(MAX_LEN * sizeof(char));

    for (int i = 0; i < q; i++) {
        int op_type;
        scanf("%d", &op_type);

        if (op_type == 1) {
            scanf("%s", arg_str);
            int arg_len = strlen(arg_str);
            
            strcpy(S + s_len, arg_str);
            s_len += arg_len;

            top++;
            undo_stack[top].type = 1;
            undo_stack[top].count = arg_len;
            undo_stack[top].deleted = NULL;

        } else if (op_type == 2) {
            int k;
            scanf("%d", &k);

            top++;
            undo_stack[top].type = 2;
            undo_stack[top].count = k;
            undo_stack[top].deleted = (char*)malloc((k + 1) * sizeof(char));
            
            strncpy(undo_stack[top].deleted, S + s_len - k, k);
            undo_stack[top].deleted[k] = '\0';

            s_len -= k;
            S[s_len] = '\0';

        } else if (op_type == 3) {
            int k;
            scanf("%d", &k);
            printf("%c\n", S[k - 1]);

        } else if (op_type == 4) {
            if (top >= 0) {
                Operation last_op = undo_stack[top];
                top--; 

                if (last_op.type == 1) {
                    s_len -= last_op.count;
                    S[s_len] = '\0';
                } else if (last_op.type == 2) {
                    strcpy(S + s_len, last_op.deleted);
                    s_len += last_op.count;
                    free(last_op.deleted); 
                }
            }
        }
    }

    while (top >= 0) {
        if (undo_stack[top].deleted != NULL) {
            free(undo_stack[top].deleted);
        }
        top--;
    }
    free(S);
    free(undo_stack);
    free(arg_str);

    return 0;
}
