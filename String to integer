#include <limits.h>
#include <ctype.h>

int myAtoi(char* s) {
    int i = 0;
    long long res = 0;
    int sign = 1;

    while (s[i] == ' ') {
        i++;
    }

    if (s[i] == '-' || s[i] == '+') {
        sign = (s[i] == '-') ? -1 : 1;
        i++;
    }

    while (s[i] >= '0' && s[i] <= '9') {
        res = res * 10 + (s[i] - '0');

        if (sign == 1 && res > INT_MAX) {
            return INT_MAX;
        }
        if (sign == -1 && -res < INT_MIN) {
            return INT_MIN;
        }

        i++;
    }

    return (int)(res * sign);
}
