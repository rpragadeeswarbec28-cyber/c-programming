#include <stdio.h>
#include <stdlib.h>

int is_prime(int n) {
    if (n < 2) return 0;
    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0) return 0;
    }
    return 1;
}

int* waiter(int number_count, int* number, int q, int* result_count) {
    int* primes = (int*)malloc(q * sizeof(int));
    int count = 0;
    int num = 2;
    while (count < q) {
        if (is_prime(num)) {
            primes[count++] = num;
        }
        num++;
    }

    int* A = (int*)malloc(number_count * sizeof(int));
    for (int i = 0; i < number_count; i++) {
        A[i] = number[i];
    }
    int a_size = number_count;

    int* answers = (int*)malloc(number_count * sizeof(int));
    int ans_idx = 0;

    for (int i = 0; i < q; i++) {
        int p = primes[i];
        int* next_A = (int*)malloc(a_size * sizeof(int));
        int next_a_size = 0;
        
        int* B = (int*)malloc(a_size * sizeof(int));
        int b_size = 0;

        for (int j = a_size - 1; j >= 0; j--) {
            if (A[j] % p == 0) {
                B[b_size++] = A[j];
            } else {
                next_A[next_a_size++] = A[j];
            }
        }

        for (int j = b_size - 1; j >= 0; j--) {
            answers[ans_idx++] = B[j];
        }

        free(A);
        free(B);
        A = next_A;
        a_size = next_a_size;
    }

    for (int j = a_size - 1; j >= 0; j--) {
        answers[ans_idx++] = A[j];
    }

    free(A);
    free(primes);

    *result_count = ans_idx;
    return answers;
}

int main() {
    int n, q;
    if (scanf("%d %d", &n, &q) != 2) return 0;

    int* number = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &number[i]) != 1) return 0;
    }

    int result_count = 0;
    int* result = waiter(n, number, q, &result_count);

    for (int i = 0; i < result_count; i++) {
        printf("%d\n", result[i]);
    }

    free(number);
    free(result);
    return 0;
}
